u_renuncia <- base_decrementos_multiples_hombres$ux_renuncia[i]
matrix(
c(
-(u_muerte + u_renuncia), u_renuncia, u_muerte,
0, 0, 0,
0, 0, 0
),
nrow = 3,
byrow = TRUE,
dimnames = list(
c("Activo", "Renuncia", "Fallecimiento"),
