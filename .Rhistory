# Note que 10000 * 95% = 9500
VaR95 <- L_ordenado[9500]
CTE95 <- mean(L_ordenado[9501:10000])
#Se imprimen la informacion y los resultados
print("Informacion general")
cat("Software:", software, "\n")
print(paste("Generador:", paste(generador, collapse = ", ")))
cat("Semilla:", semilla, "\n")
print("Resultados de la simulacion")
cat("NPV medio:", NPV_medio, "\n")
cat("Complemento medio:",  complemento_medio, "\n")
cat("Proporcion de NPV negativos:", prop_NPV_negativo, "\n")
cat("Proporcion de garantias activadas:", prop_garantia_activada, "\n")
cat("VaR al 95%:", VaR95, "\n")
cat("CTE al 95%:", CTE95, "\n")
set.seed(309)
# Se registran el software, el generador y la semilla
software <- R.version.string
generador <- RNGkind()
semilla <- 309
# Se definen los parametros de la simulacion
N <- 10000
P <- 1000
a <- 0.02
E0 <- 25
c <- 0.02
E1 <- 10
G <- 1000
k <- 0.08
miu <- 0.06
sigma <- 0.20
trian_t <- 1
# Se producen los choques normales estandar
Z <- rnorm(N, mean = 0, sd = 1)
# Se calcula el rendimiento bajo el modelo lognormal
R_s_t <- exp((miu - sigma^2 / 2) * trian_t +
sigma * sqrt(trian_t) * Z) - 1
# Se definen las formulas del modelo
F0 <- (1 - a) * P
C0 <- a * P
F1_negativo <- F0 * (1 + R_s_t)
C1 <- c * F1_negativo
F1 <- F1_negativo - C1
H1 <- pmax(G - F1, 0)
U0 <- C0 - E0
U1 <- C1 - E1 - H1
NPV <- U0 + U1 / (1 + k)
# Se construyen las perdida como se define en el enunciado
L <- -NPV
#Se ordenan las perdidas
L_ordenado <- sort(L)
# Se calculan los elementos solicitados
NPV_medio <- mean(NPV)
complemento_medio <- mean(H1)
prop_NPV_negativo <- mean(NPV < 0)
prop_garantia_activada <- mean(H1 > 0)
# Se calculan  VaR y CTE al 95%
# Note que 10000 * 95% = 9500
VaR95 <- L_ordenado[9500]
CTE95 <- mean(L_ordenado[9501:10000])
#Se imprimen la informacion y los resultados
cat("Informacion general")
cat("Software:", software, "\n")
print(paste("Generador:", paste(generador, collapse = ", ")))
cat("Semilla:", semilla, "\n")
print("Resultados de la simulacion")
cat("NPV medio:", NPV_medio, "\n")
cat("Complemento medio:",  complemento_medio, "\n")
cat("Proporcion de NPV negativos:", prop_NPV_negativo, "\n")
cat("Proporcion de garantias activadas:", prop_garantia_activada, "\n")
cat("VaR al 95%:", VaR95, "\n")
cat("CTE al 95%:", CTE95, "\n")
